{
  "name": "paddock-live-desktop",
  "version": "1.1.1",
  "description": "Paddock Live — application de bureau",
  "main": "main.cjs",
  "desktopName": "paddock-live-desktop.desktop",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Paddock Live",
    "email": "paddock-live@users.noreply.github.com"
  },
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist": "node prepare.mjs && electron-builder --win nsis portable --publish never",
    "dist:linux": "node prepare.mjs && electron-builder --linux --publish never",
    "dist:mac": "node prepare.mjs && electron-builder --mac --publish never"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.paddocklive.desktop",
    "productName": "Paddock Live",
    "copyright": "© 2026 Paddock Live",
    "icon": "icon.png",
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "version.cjs",
      "f1-cookies.cjs",
      "countdown.cjs",
      "splash.html",
      "icon.png",
      "bundle/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "Paddock-Live-${version}-${arch}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Paddock Live"
    },
    "portable": {
      "artifactName": "Paddock-Live-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Paddock Live écoute le son de votre TV pour se caler automatiquement sur la diffusion (synchro TV par le son). Rien n'est enregistré ni envoyé."
      },
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Paddock-Live-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Paddock-Live-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "synopsis": "Dashboard Formule 1 en direct",
      "maintainer": "Paddock Live <paddock-live@users.noreply.github.com>",
      "artifactName": "Paddock-Live-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "electronVersion": "44.5.1",
    "electronDownload": {
      "version": "44.5.1+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "./vmp-sign.cjs",
    "afterPack": "./vmp-after-pack.cjs",
    "publish": {
      "provider": "github",
      "owner": "benjamin-ct",
      "repo": "paddock-live",
      "releaseType": "release"
    }
  },
  "paddockLive": {
    "updateRepo": "benjamin-ct/paddock-live"
  },
  "homepage": "https://github.com/benjamin-ct/paddock-live"
}
