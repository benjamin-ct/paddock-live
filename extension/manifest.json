{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Paddock Live",
  "description": "__MSG_description__",
  "version": "1.0.2",
  "default_locale": "en",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://*.formula1.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Paddock Live Companion" },
  "browser_specific_settings": { "gecko": { "id": "companion@paddocklive.app", "strict_min_version": "121.0", "data_collection_permissions": { "required": ["none"] } } }
}
